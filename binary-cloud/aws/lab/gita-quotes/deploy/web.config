<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows: copy to C:\inetpub\wwwroot next to index.html.
     Needs the URL Rewrite and Application Request Routing (ARR) modules,
     with "Enable proxy" ticked in ARR's Server Proxy Settings.
     The /api prefix is kept when forwarding, because the Flask routes start with /api. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="api-to-waitress" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
